# Copy to .env.local and fill in from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Daily leftovers reminder (web-push + cron). Generate a VAPID keypair with:
#   npx web-push generate-vapid-keys
# Put the public key here, the private key + contact subject in Vercel env vars.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only (set in Vercel, never commit): VAPID_PRIVATE_KEY, VAPID_SUBJECT
# (mailto:you@example.com), SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET
